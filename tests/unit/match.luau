--!strict
local Service = require("../../build/test-source/server/application/match/MatchService")
local Config = require("../../build/test-source/server/config/Match")
local total = 0
local function test(name, run)
	run()
	total += 1
	print("PASS", name)
end
local function close(a, b) assert(math.abs(a - b) < 0.000001, tostring(a) .. " ~= " .. tostring(b)) end
local function fixture(count, overrides)
	local config = table.clone(Config)
	for key, value in overrides or {} do config[key] = value end
	local f = { resets = {}, freezes = {}, now = 0 }
	f.service = Service.new({
		reset = function(owner, team, frozen) table.insert(f.resets, {owner=owner,team=team,frozen=frozen}) end,
		freeze = function(owner, frozen) table.insert(f.freezes, {owner=owner,frozen=frozen}) end,
	}, config)
	for owner = 1, count or 2 do f.service.join(owner, 0); assert(f.service.ready(owner, true, 0)) end
	function f.step(now, occupants)
		f.now = now
		f.service.step(now, occupants or {})
		return f.service.snapshot(1, now)
	end
	function f.active()
		f.step(config.gathering)
		return f.step(config.gathering + config.countdown)
	end
	function f.add(owner)
		f.service.join(owner, f.now)
		assert(f.service.ready(owner, true, f.now))
	end
	return f
end

test("2/3/4/5/6 ready select maximum even roster, idle visitor stays training", function()
	for count = 2, 6 do
		local f = fixture(count)
		f.service.join(100, 0)
		assert(f.step(9).phase == "gathering")
		assert(f.step(10).phase == "countdown" and not f.service.canAct(1))
		local limit = count - count % 2
		for owner = 1, limit do
			local c = f.service.context(owner)
			assert(c.mode == "match" and c.team == (if owner % 2 == 1 then 1 else 2) and c.frozen)
		end
		if count % 2 == 1 then assert(f.service.snapshot(count, 10).queuePosition == 1) end
		assert(f.service.context(100).mode == "training" and f.service.canAct(100))
		assert(f.step(13).phase == "active" and f.service.canAct(1))
	end
end)
test("continuous waiting priority survives cancel of someone else and next gathering", function()
	local f = fixture(3)
	f.service.ready(1, false, 1)
	f.service.ready(1, true, 2)
	f.active()
	assert(f.service.context(2).team == 1 and f.service.context(3).team == 2)
	assert(f.service.snapshot(1, 13).queuePosition == 1)
end)
test("gathering cancels below two and restarts with original waiting player", function()
	local f = fixture(2)
	f.service.ready(2, false, 4)
	assert(f.step(10).phase == "idle" and f.service.snapshot(1, 10).queuePosition == 1)
	f.add(3)
	assert(f.step(19).phase == "gathering")
	f.step(20)
	assert(f.service.context(1).team == 1 and f.service.context(3).team == 2)
end)
test("cancel during initial countdown pauses then replaces and resets all", function()
	local f = fixture(3)
	f.step(10)
	assert(f.service.ready(1, false, 11))
	local s = f.service.snapshot(2, 11)
	assert(s.phase == "resuming" and s.deadline == 14)
	assert(f.service.context(3).team == 1)
	assert(f.step(14).phase == "active")
end)
test("neutral, enemy, contested including 3 versus 1 and training presence", function()
	local f = fixture(6)
	f.service.join(100, 0)
	f.active()
	assert(f.step(14, {[100]=true}).zone == "neutral")
	assert(f.step(15, {[1]=true,[3]=true,[5]=true}).zone == "A")
	local s = f.step(20, {[1]=true,[3]=true,[5]=true,[2]=true})
	assert(s.zone == "contested" and s.scoreA == 1 and s.scoreB == 0)
	s = f.step(23, {[2]=true})
	assert(s.zone == "B" and s.scoreB == 3 and s.scoreA == 1)
end)
test("one and three allies earn exactly one point per second", function()
	local f = fixture(6)
	f.active()
	assert(f.step(23, {[1]=true}).scoreA == 10)
	assert(f.step(33, {[1]=true,[3]=true,[5]=true}).scoreA == 20)
end)
test("death removes occupation without replacing or dropping membership", function()
	local f = fixture(2)
	f.active()
	assert(f.step(20, {[1]=true}).scoreA == 7)
	local s = f.step(25, {})
	assert(s.phase == "active" and s.scoreA == 7 and s.zone == "neutral")
	assert(f.service.context(1).team == 1)
end)
test("long frame caps score at target and returns one immutable personalized result", function()
	local f = fixture(2)
	f.active()
	local s = f.step(1000, {[1]=true})
	assert(s.phase == "finished" and s.scoreA == 150 and s.result.reason == "score" and s.result.winner == 1)
	close(s.remaining, 150)
	assert(f.service.context(1).mode == "training" and f.service.canAct(1))
	local resets = #f.resets
	s.result.scoreA = 999
	assert(f.step(1100, {[1]=true}).result.scoreA == 150 and #f.resets == resets)
end)
test("time produces tie or larger-score winner and target wins exact shared boundary", function()
	local f = fixture(2)
	f.active()
	assert(f.step(313).result.reason == "time" and f.service.snapshot(1,313).result.winner == nil)
	local g = fixture(2)
	g.active(); g.step(20, {[2]=true})
	assert(g.step(313).result.winner == 2)
	local h = fixture(2, {duration=150})
	h.active()
	local s = h.step(163, {[1]=true})
	assert(s.result.reason == "score" and s.result.winner == 1)
end)
test("time compares displayed whole points while retaining fractional occupation time", function()
	local f = fixture(2, {duration=3})
	f.active()
	f.step(13.9, {[1]=true})
	f.step(14.7, {[2]=true})
	local tie = f.step(16)
	assert(tie.result.reason == "time" and tie.result.scoreA == 0 and tie.result.scoreB == 0)
	assert(tie.result.winner == nil)
	local g = fixture(2, {duration=3})
	g.active()
	g.step(14.1, {[1]=true})
	g.step(15, {[2]=true})
	local win = g.step(16)
	assert(win.result.reason == "time" and win.result.scoreA == 1 and win.result.scoreB == 0)
	assert(win.result.winner == 1)
end)
test("pair reserves together, keeps original game running then enters simultaneously", function()
	local f = fixture(2)
	f.active(); f.step(20, {[1]=true})
	f.add(3)
	assert(f.service.context(3).mode == "training")
	f.add(4)
	assert(f.service.context(3).frozen and f.service.context(4).frozen)
	assert(f.service.snapshot(3,20).pairDeadline == 23)
	assert(f.step(22, {[1]=true,[3]=true}).countA == 1)
	local s = f.step(23, {[1]=true})
	assert(s.scoreA == 10 and not f.service.context(3).frozen and not f.service.context(4).frozen)
	assert(f.service.context(3).team == 1 and f.service.context(4).team == 2)
	close(s.remaining, 290)
end)
test("pair cancellation returns both to training, preserves remaining wait priority", function()
	local f = fixture(2)
	f.active(); f.add(3); f.add(4)
	f.service.ready(3, false, 14)
	assert(f.service.context(4).mode == "training" and f.service.canAct(4))
	assert(f.service.snapshot(4,14).queuePosition == 1)
	f.now = 15; f.add(5)
	assert(f.service.snapshot(4,15).pairDeadline == 18)
	f.step(18)
	assert(f.service.context(4).team == 1 and f.service.context(5).team == 2)
end)
test("no pair can complete expansion within last thirty seconds", function()
	local f = fixture(2)
	f.active(); f.step(281)
	f.add(3); f.add(4)
	assert(f.service.context(3).mode == "training")
	assert(f.step(285).phase == "active" and f.service.context(4).mode == "training")
end)
test("pause freezes points, clock and actions; queued replacement resets all lives", function()
	local f = fixture(4)
	f.active(); f.step(20, {[1]=true})
	f.service.exit(1, 20)
	assert(f.service.snapshot(2,20).phase == "paused" and not f.service.canAct(2))
	local s = f.step(30, {[2]=true})
	assert(s.scoreA == 7 and s.scoreB == 0); close(s.remaining, 293)
	f.add(5)
	s = f.service.snapshot(5,30)
	assert(s.phase == "resuming" and s.team == 1 and s.deadline == 33)
	local replacementLives = 0
	for _, reset in f.resets do if reset.owner == 5 then replacementLives += 1 end end
	assert(replacementLives == 1)
	f.step(33)
	assert(f.service.canAct(2) and f.service.context(1).mode == "training")
	s = f.step(35, {[2]=true})
	assert(s.scoreB == 2); close(s.remaining, 291)
end)
test("opposite departures resume smaller equal roster with same match and score", function()
	local f = fixture(4)
	f.active(); f.step(20, {[1]=true})
	f.service.exit(1, 20); f.service.exit(2, 21)
	local s = f.service.snapshot(3,21)
	assert(s.phase == "resuming" and s.matchId == 1 and s.scoreA == 7)
	assert(f.step(24).phase == "active")
end)
test("fifteen-second timeout interrupts once, no winner, late requests cannot resume", function()
	local f = fixture(2)
	f.active(); f.service.leave(1, 20)
	assert(f.step(34).phase == "paused")
	local s = f.step(35)
	assert(s.phase == "finished")
	local result = f.service.snapshot(2,35).result
	assert(result.reason == "interrupted" and result.winner == nil)
	assert(not f.service.ready(1,true,36))
	assert(f.service.context(2).mode == "training")
end)
test("both teams empty finishes immediately without extending paused deadline", function()
	local f = fixture(2)
	f.active(); f.service.exit(1,20)
	assert(f.service.snapshot(2,20).deadline == 35)
	f.service.exit(2,21)
	assert(f.service.snapshot(2,21).phase == "finished")
end)
test("replacement remains allowed in final thirty seconds", function()
	local f = fixture(2)
	f.active(); f.step(290)
	f.add(3); f.service.exit(1,290)
	assert(f.service.snapshot(3,290).phase == "resuming" and f.service.context(3).team == 1)
	f.step(293)
	close(f.service.snapshot(3,293).remaining, 23)
end)
test("new match clears old roster scores results and appends returnees after waiting", function()
	local f = fixture(3, {target=2})
	f.active(); f.step(15, {[1]=true})
	assert(f.service.snapshot(1,15).result.winner == 1)
	f.service.ready(2,true,15); f.step(25)
	assert(f.service.context(3).team == 1 and f.service.context(2).team == 2)
	local s = f.service.snapshot(2,25)
	assert(s.matchId == 2 and s.scoreA == 0 and s.result == nil)
	assert(f.service.context(1).mode == "training")
	f.step(28); assert(f.step(29, {[1]=true}).scoreA == 0)
end)
test("snapshot version changes on visible state, not every heartbeat; destroy rejects actions", function()
	local f = fixture(2)
	f.active()
	local v = f.step(13.1, {[1]=true}).version
	assert(f.step(13.2, {[1]=true}).version == v)
	assert(f.step(14.1, {[1]=true}).version > v)
	f.service.destroy(); f.service.destroy()
	assert(not f.service.canAct(1) and not f.service.ready(1,true,20))
end)
print("Match contracts:", total, "passed")
